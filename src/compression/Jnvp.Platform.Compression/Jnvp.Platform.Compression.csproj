<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Jnvp.Platform.Compression</PackageId>
    <Description>GZip, Brotli, and Deflate compression implementations for byte buffers and streams.</Description>
    <PackageTags>compression;gzip;brotli;deflate;streams</PackageTags>
    <PackageProjectUrl>https://github.com/vikashchauhan90/components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vikashchauhan90/components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StrongNameKeyFile)' != ''">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(StrongNameKeyFile)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
	</ItemGroup>
</Project>
