<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Jnvp.Platform.Resilience</PackageId>
    <Description>Reusable resilience policies for .NET applications using Polly pipelines.</Description>
    <PackageTags>resilience;polly;retry;circuit-breaker;timeout</PackageTags>
    <PackageProjectUrl>https://github.com/vikashchauhan90/components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vikashchauhan90/components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StrongNameKeyFile)' != ''">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(StrongNameKeyFile)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Resilience" Version="11.0.0" />
	</ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
